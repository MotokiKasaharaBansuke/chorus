{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chorus",
  "version": "0.4.0",
  "identifier": "com.kasaharamotoki.chorus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chorus",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/tmp/chorus-images/**",
          "/private/tmp/chorus-images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
